{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Los scripts de operación de `db/flota/` y el fixture del e2e son .mjs de verdad, y el
    // e2e de ruteo los importa para hablarle al mismo registro que el servidor. `allowJs` los
    // deja resolver; `checkJs` queda apagado (su default) porque son de otro árbol y con su
    // propio gate: chequearlos desde acá sería auditar código ajeno con las reglas de esta app.
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@kilopan/miga/*": ["../../packages/miga/src/*"],
      "@kilopan/nucleo-comun/*": ["../../packages/nucleo-comun/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next-env.d.ts", ".next-e2e/types/**/*.ts"],
  "exclude": ["node_modules"]
}
