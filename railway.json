{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter kilopan run build"
  },
  "deploy": {
    "startCommand": "node db/migrar.mjs && node apps/kilopan/.next/standalone/apps/kilopan/server.js",
    "healthcheckPath": "/ingresar",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
