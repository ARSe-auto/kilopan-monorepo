# Copiar a .env.local (gitignored). Nunca commitear valores reales.
#
# Antes de apuntar a un host nuevo:  node db/verificar-conexion.mjs

# --- Base de datos ---------------------------------------------------------
# pglite   = desarrollo en una sola máquina, cero instalación. NO sirve para operar:
#            es un motor embebido de UN SOLO PROCESO, así que no puede atender a la
#            tablet del mesón, el teléfono del repartidor y el del dueño a la vez.
# postgres = el modo real. Mismo SQL, mismas migraciones, mismas invariantes.
DB_MODE=pglite

# Solo en modo postgres.
#
# IMPORTANTE: la URL va SIN ?sslmode=. node-postgres no usa la semántica de libpq
# (trata 'require' como 'verify-full') y, si la URL trae sslmode, DESCARTA en silencio
# la configuración TLS del código. El guardrail la rechaza a propósito.
#
#   local:            postgres://kilopan:kilopan@localhost:5432/kilopan_dev
#   Railway privada:  postgres://postgres:CLAVE@postgres.railway.internal:5432/railway
#   Railway pública:  postgres://postgres:CLAVE@HOST.proxy.rlwy.net:PUERTO/railway
DATABASE_URL=

# Apuntar a una BD remota tiene que ser un acto deliberado: sin esta bandera,
# guardrail.sh y las migraciones abortan. Existe para que nadie corra una migración
# sobre la panadería equivocada — eso no tiene deshacer.
KILOPAN_DB_REMOTA_INTENCIONAL=

# Solo para el proxy PÚBLICO de Railway (*.proxy.rlwy.net). Su certificado es
# autofirmado con CN=localhost, así que la verificación estricta es imposible por
# construcción. Esto cifra pero NO autentica: quedas expuesto a un intermediario que
# se haga pasar por la base. Aceptable en desarrollo; en producción usa la red privada
# (postgres.railway.internal), que va cifrada con Wireguard y no necesita esto.
KILOPAN_TLS_SIN_VERIFICAR=

# Solo si activaste Connection Pooling (PgBouncer) en Railway: las migraciones
# necesitan la cadena SIN pooler — DDL y funciones no sobreviven al modo transacción.
KILOPAN_MIGRACIONES_URL=

# Tamaño del pool. `node db/verificar-conexion.mjs` sugiere el número según el
# max_connections real del servidor.
DB_POOL_MAX=10

# --- Integración KiloRuta (Anexo B, post-DONE) -----------------------------
# Secreto para firmar el webhook del POD. Generar con: openssl rand -hex 32
FLOTA_WEBHOOK_HMAC_SECRET=

NODE_ENV=development
