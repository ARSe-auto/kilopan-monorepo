# Copiar a .env.local (gitignored). Nunca commitear valores reales.

# --- Base de datos ---------------------------------------------------------
# pglite   = desarrollo en una sola máquina, cero instalación. NO sirve para operar:
#            es un motor embebido de UN SOLO PROCESO, así que no puede atender a la
#            tablet del mesón, el teléfono del repartidor y el del dueño a la vez.
# postgres = el modo real. Mismo SQL, mismas migraciones, mismas invariantes.
DB_MODE=pglite

# Solo en modo postgres. Contra un host remoto es OBLIGATORIO sslmode=require:
# por esta conexión viajan RUTs, PINs hasheados y evidencia de entregas.
#   local:    postgres://kilopan:kilopan@localhost:5432/kilopan_dev
#   hospedado: postgres://USUARIO:CLAVE@HOST/kilopan?sslmode=require
DATABASE_URL=

# Apuntar el entorno a una BD remota tiene que ser un acto deliberado: sin esta
# bandera, guardrail.sh y las migraciones abortan. Existe para que nadie corra una
# migración sobre la panadería equivocada — eso no tiene deshacer.
KILOPAN_DB_REMOTA_INTENCIONAL=

# Tamaño del pool. Con proveedores hospedados que cobran por conexión, bajarlo.
DB_POOL_MAX=10

# --- Integración KiloRuta (Anexo B, post-DONE) -----------------------------
# Secreto para firmar el webhook del POD. Generar con: openssl rand -hex 32
FLOTA_WEBHOOK_HMAC_SECRET=

NODE_ENV=development
