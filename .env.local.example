# Copiar a .env.local (gitignored). Nunca commitear valores reales.
# guardrail.sh aborta si DATABASE_URL no apunta a localhost/127.0.0.1.
DATABASE_URL=postgres://kilopan:kilopan@localhost:5432/kilopan_dev

# Modo de base de datos para el loop local: "pglite" (por defecto, cero instalación)
# o "postgres" (real, requiere `brew install postgresql@16` o Docker — ver docs/BASE_DE_DATOS.md).
DB_MODE=pglite

# Secreto para firmar HMAC del webhook KiloRuta (Anexo B) — generar con: openssl rand -hex 32
FLOTA_WEBHOOK_HMAC_SECRET=

NODE_ENV=development
