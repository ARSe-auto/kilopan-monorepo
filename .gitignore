.next/
dist/
build/
.env.local
.env*.local
# db/conectar-railway.mjs deja .env.local.respaldo al reescribir la config, y ese
# archivo SÍ lleva la cadena de conexión real. El patrón .env*.local no lo cubre
# (no termina en .local) — se coló al stage una vez y por suerte todavía tenía el
# placeholder de localhost adentro.
.env.local.*
*.log
.DS_Store
db/data/
packages/metodo/panel/index.html
packages/metodo/panel/estado.json
# Estado de runtime del motor: qué ACs quedaron atascados y si está en pausa esperando
# que una persona lo revise. Es operativo, no contrato — versionarlo haría que el árbol
# quede sucio en cada iteración y el propio loop lo stashearía.
packages/metodo/panel/acs-atascados.txt
packages/metodo/panel/PAUSA-REVISION
.ralph/
*.tsbuildinfo
apps/kilopan/playwright-report/
apps/kilopan/test-results/
apps/kilopan/blob-report/

# Generados por el e2e en cada corrida (ver apps/kilopan/e2e/preparar-base.mjs).
apps/kilopan/e2e/datos-semilla.json
apps/kilopan/test-results/
apps/kilopan/playwright-report/

# locks del arnes (efimeros, por worktree)
.metodo-locks/

# distDir del e2e (build propio, separado del .next de produccion)
apps/kilopan/.next-e2e/

